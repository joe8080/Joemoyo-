# Copy to .env and fill in. NEVER commit .env.
# Free Alpaca paper keys: https://app.alpaca.markets (Paper Trading > API Keys)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Optional: full market data feed if your Alpaca plan includes it (else IEX).
ALPACA_DATA_FEED=sip

# Optional: written AI coach narrative (without it you still get deterministic stats).
ANTHROPIC_API_KEY=

# Optional: durable memory + persistent journal (Supabase service-role key).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

OUTPUT_DIR=./outputs
