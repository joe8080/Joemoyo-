{
  "name": "aift-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI Finance Toolkit Studio - private research-to-YouTube production studio. No publishing, no trading.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:no-publish": "tsx scripts/guard-no-publish.ts",
    "guard:no-secrets": "tsx scripts/guard-no-client-secrets.ts",
    "verify": "npm run typecheck && npm run guard:no-publish && npm run test",
    "pack:demo": "tsx scripts/run-demo-pack.ts",
    "render:pack": "tsx scripts/render-pack.ts",
    "seed": "tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "ffmpeg-static": "^5.2.0",
    "playwright-core": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
