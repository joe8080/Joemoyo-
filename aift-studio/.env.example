# =============================================================================
# AI Finance Toolkit Studio — environment template
# Copy to `.env.local`.  NEVER commit real values.  NEVER add NEXT_PUBLIC_ to
# any key below except SUPABASE_URL / SUPABASE_ANON_KEY (see note at bottom).
# =============================================================================

# --- Supabase (project "finance chief") -------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server / worker process ONLY. A startup guard aborts the app if this value is
# ever readable from a NEXT_PUBLIC_* variable or reaches a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Language models ---------------------------------------------------------
# Leave AIFT_LLM_API_KEY empty to run the whole workflow in MOCK mode.
AIFT_LLM_API_KEY=
AIFT_LLM_BASE_URL=
AIFT_LLM_MODEL_FAST=
AIFT_LLM_MODEL_REVIEW=

# --- Generative media (atmospheric B-roll ONLY, never data) ------------------
AIFT_MEDIA_PROVIDER=mock
AIFT_MEDIA_API_KEY=

# --- Narration ---------------------------------------------------------------
# mock   = silent, exactly-timed narration track (default, no credentials)
# espeak = offline espeak-ng binary, if installed (rough preview voice)
# http   = licensed cloud TTS via AIFT_TTS_BASE_URL + AIFT_TTS_API_KEY
AIFT_TTS_PROVIDER=mock
AIFT_TTS_API_KEY=
AIFT_TTS_BASE_URL=
AIFT_TTS_VOICE=

# --- Storage -----------------------------------------------------------------
# `local` writes to ./.artifacts (git-ignored). `supabase` uses a PRIVATE bucket.
AIFT_STORAGE_DRIVER=local
AIFT_STORAGE_BUCKET=aift-private-assets

# --- App ---------------------------------------------------------------------
AIFT_APP_BASE_URL=http://localhost:3000
# Used to sign scheduler webhook payloads. Generate: openssl rand -hex 32
AIFT_JOB_SIGNING_SECRET=

# --- Render engine (optional overrides) --------------------------------------
# Absolute path to a Chromium binary. Defaults to the Playwright-managed one.
AIFT_CHROMIUM_PATH=
# Absolute path to an ffmpeg binary. Defaults to the bundled ffmpeg-static.
AIFT_FFMPEG_PATH=

# =============================================================================
# DELIBERATELY ABSENT — do not add these in version one
# =============================================================================
# YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET / YOUTUBE_REFRESH_TOKEN
# Any OAuth scope containing "youtube.upload" or "youtube.force-ssl".
# `npm run guard:no-publish` fails the build if upload code or scopes appear.
#
# There are no brokerage, order-entry, or funds-transfer credentials in this
# product and there never will be. It is a research and content tool.
