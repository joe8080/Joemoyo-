# Environment - NEVER commit this
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Generated content (optional - remove if you want to track outputs in git)
# outputs/

# Auto-trader runtime logs (regenerated on every run)
outputs/reports/autotrade_log_*.md

# Voice generator
# NB: gitignore has no inline comments - a trailing "# ..." becomes part of
# the pattern and silently stops it matching. Keep comments on their own line.
# VibeVoice checkout, recreated by voice/setup.sh
voice/vendor/
# Voice samples are biometric data - never commit these
voice/voices/*.wav
voice/outputs/*.wav
voice/scripts/episode.txt

# IDE
.vscode/
.idea/
*.swp
