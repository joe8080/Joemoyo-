# =============================================================
# JoeMoyo Business Agent System - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------
# REQUIRED — unless you use the Claude Code backend below
# ---------------------------
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------
# BACKEND (how agents reach the model)
# ---------------------------
# "sdk" (default) calls the Anthropic API and needs ANTHROPIC_API_KEY above.
# "claude_cli" shells out to the Claude Code CLI instead — no API key, no
# separate bill, same models. Requires the `claude` CLI and a signed-in session.
#   AGENT_BACKEND=claude_cli
AGENT_BACKEND=sdk

# Override the model for either backend (default claude-sonnet-4-6)
# AGENT_MODEL=claude-opus-5

# On the claude_cli backend, agents reach the OGX database through the
# Supabase MCP instead of the REST keys below. Point this at an MCP config
# containing your Supabase server.
# CLAUDE_MCP_CONFIG=/path/to/mcp-config.json

# Seconds before a single CLI agent call is abandoned (default 1800)
# CLAUDE_CLI_TIMEOUT=1800

# ---------------------------
# WEB SEARCH (pick one)
# ---------------------------
# Brave Search API - https://api.search.brave.com
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ---------------------------
# OGX RESEARCH DATABASE (required for the OrigineX pipeline)
# ---------------------------
# The OrigineX Human Archives Supabase project. Every OGX claim is verified
# against this before it ships, so `python main.py ogx` will not run without it
# (override with --allow-unverified). Service-role key — server-side only.
# Supabase dashboard > Project Settings > API
OGX_SUPABASE_URL=https://qvlllknedilztozxwscj.supabase.co
OGX_SUPABASE_SERVICE_KEY=your_ogx_service_role_key_here

# ---------------------------
# SHOPIFY (for reporting agent)
# ---------------------------
# Shopify Admin API - Settings > Apps > Develop apps > Create app
SHOPIFY_SHOP_NAME=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here

# ---------------------------
# ALPACA (for paper trading agent)
# ---------------------------
# Get free paper keys at https://app.alpaca.markets
#   (Home > Paper Trading > API Keys > Generate New Key)
# The Secret Key is shown ONLY ONCE at creation — save it immediately.
ALPACA_API_KEY_ID=PKxxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
# Keep this "true" for safe simulated trading. Set to "false" ONLY to trade
# real money on the live account (https://api.alpaca.markets).
ALPACA_PAPER=true

# ---------------------------
# BRAND NAMES (customize these)
# ---------------------------
YOUTUBE_HISTORY_CHANNEL_NAME=Chronicles of Time
YOUTUBE_FINANCE_CHANNEL_NAME=Capital Edge
MUSIC_STUDIO_NAME=JoeMoyo Studios
SHOPIFY_STORE_NAME=JoeMoyo Store

# ---------------------------
# OUTPUT SETTINGS
# ---------------------------
OUTPUT_DIR=./outputs
