# Copy this file to .env and fill in your Alpaca keys
# .env is gitignored — never commit your real keys

# Paper trading (safe for testing) — get from https://app.alpaca.markets
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER=true

# Set ALPACA_PAPER=false to switch to live trading
# Live trading keys are different from paper keys
