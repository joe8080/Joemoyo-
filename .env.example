# =============================================================
# JoeMoyo Business Agent System - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------
# REQUIRED
# ---------------------------
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------
# WEB SEARCH (pick one)
# ---------------------------
# Brave Search API - https://api.search.brave.com
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ---------------------------
# SHOPIFY (for reporting agent)
# ---------------------------
# Shopify Admin API - Settings > Apps > Develop apps > Create app
SHOPIFY_SHOP_NAME=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here

# ---------------------------
# BRAND NAMES (customize these)
# ---------------------------
YOUTUBE_HISTORY_CHANNEL_NAME=Chronicles of Time
YOUTUBE_FINANCE_CHANNEL_NAME=Capital Edge
MUSIC_STUDIO_NAME=JoeMoyo Studios
SHOPIFY_STORE_NAME=JoeMoyo Store

# ---------------------------
# SUPABASE — SOURCE OF TRUTH (ORIGINEX HUMAN ARCHIVES)
# ---------------------------
# Project Settings > API. Service role key is required for writes + Storage.
SUPABASE_URL=https://qvlllknedilztozxwscj.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_PROJECT_ID=qvlllknedilztozxwscj
SUPABASE_STORAGE_BUCKET=video-assets

# ---------------------------
# MEDIA GENERATION (video production crew)
# ---------------------------
# Image provider: openai | gemini | higgsfield | firefly
IMAGE_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs — Joe's cloned voice for narration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ---------------------------
# OUTPUT SETTINGS
# ---------------------------
OUTPUT_DIR=./outputs
VIDEO_OUTPUT_DIR=./outputs/videos
