# =============================================================
# JoeMoyo Business Agent System - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------
# REQUIRED
# ---------------------------
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------
# WEB SEARCH (pick one)
# ---------------------------
# Brave Search API - https://api.search.brave.com
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ---------------------------
# SHOPIFY (for reporting agent)
# ---------------------------
# Shopify Admin API - Settings > Apps > Develop apps > Create app
SHOPIFY_SHOP_NAME=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here

# ---------------------------
# ALPACA (for paper trading agent)
# ---------------------------
# Get free paper keys at https://app.alpaca.markets
#   (Home > Paper Trading > API Keys > Generate New Key)
# The Secret Key is shown ONLY ONCE at creation — save it immediately.
ALPACA_API_KEY_ID=PKxxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
# Keep this "true" for safe simulated trading. Set to "false" ONLY to trade
# real money on the live account (https://api.alpaca.markets).
ALPACA_PAPER=true

# ---------------------------
# BRAND NAMES (customize these)
# ---------------------------
YOUTUBE_HISTORY_CHANNEL_NAME=Chronicles of Time
YOUTUBE_FINANCE_CHANNEL_NAME=Capital Edge
MUSIC_STUDIO_NAME=JoeMoyo Studios
SHOPIFY_STORE_NAME=JoeMoyo Store

# ---------------------------
# OUTPUT SETTINGS
# ---------------------------
OUTPUT_DIR=./outputs

# ---------------------------
# JARVIS (Telegram voice assistant) - see docs/JARVIS.md
# ---------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
# Your own chat id (Jarvis answers this chat only). Leave blank to use
# telegram_config in the Vault; message the bot once and it tells you the id.
TELEGRAM_CHAT_ID=
# The Vault: finance-chief Supabase project (service-role key, server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
# OrigineX Human Archives Supabase project (content, citations, debates)
OGX_SUPABASE_URL=https://your-ogx-project.supabase.co
OGX_SUPABASE_SERVICE_KEY=your_ogx_service_role_key
# Voice in: OpenAI Whisper (or ElevenLabs Scribe if only the ElevenLabs key is set)
OPENAI_API_KEY=
# Voice out: ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Tuning (all optional)
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=high
JARVIS_NAME=Jarvis
JARVIS_VOICE_REPLIES=true
