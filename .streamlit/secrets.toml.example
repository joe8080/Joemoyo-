# Streamlit secrets for the trading dashboard.
#
# Local use:   copy to .streamlit/secrets.toml (gitignored) — or just use .env.
# Streamlit Community Cloud: paste these lines into the app's
#   Settings -> Secrets box at share.streamlit.io.

ALPACA_API_KEY_ID = "your-paper-key-id"
ALPACA_API_SECRET_KEY = "your-paper-secret-key"
ALPACA_PAPER = "true"

# Optional — durable history + persistent journal/coach across restarts.
# Supabase project URL and SERVICE-ROLE key (Settings -> API in Supabase).
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY = "your-service-role-key"
