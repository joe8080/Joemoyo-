# ─────────────────────────────────────────────────────────────
# JoeMoyo OS — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# --- AI providers (AI Hub) ---
ANTHROPIC_API_KEY=sk-ant-...        # Claude — console.anthropic.com
OPENAI_API_KEY=sk-...               # ChatGPT — platform.openai.com
PERPLEXITY_API_KEY=pplx-...         # Perplexity — perplexity.ai/settings/api

# --- Supabase (the Vault) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...     # safe for the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # server-only, full access — keep secret

# --- Market data (Investing module, Phase 3) ---
# Free tiers: financialmodelingprep.com / alphavantage.co
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- YouTube / Social (Phase 4) ---
# Google Cloud console → OAuth client (Web). Enable YouTube Data API v3.
# Authorized redirect URI: <your-domain>/api/social/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your deployed URL (used to build the OAuth redirect). Locally: http://localhost:3000
NEXT_PUBLIC_BASE_URL=
